# Optional Docker Compose overrides. The same values are built into
# docker-compose.yml, so a fresh clone can also run without copying this file.
NGINX_BIND_HOST=127.0.0.1
NGINX_PORT=8082
WSI_VIEWER_FRONTEND_IMAGE=hkustmdi/wsi_image_viewer_frontend:2.0
WSI_VIEWER_BACKEND_IMAGE=hkustmdi/wsi_image_viewer_backend:1.0

# Leave empty when the viewer is served at the domain root. For a reverse
# proxy such as https://example.com/openmetal-wsiviewer/, use this value:
WSI_VIEWER_BASE_PATH=
# Optional absolute or path-only API override. Empty means <base path>/api.
WSI_VIEWER_API_BASE=
